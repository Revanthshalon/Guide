{"nodes": [{"id": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_monotonic_stack", "label": "Monotonic Stack", "file_type": "rationale", "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "Mental Model / The Invariant", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discards elements that can never be the answer again: if v[j] > v[i] and j > i, v[i] is dominated. Converts Theta(n^2) into Theta(n) because each element is pushed once and popped at most once. The pop IS where the answer is recorded."}, {"id": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_monotonic_deque", "label": "Monotonic Deque (Sliding Window Max)", "file_type": "rationale", "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "Mechanics", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indices increasing, values decreasing so the front is the window max. Measured k-independent (11.35 ms at k=100 vs 11.20 ms at k=10,000) on n=1,000,000 \u2014 the signature of the technique. The heap was within 10% at large k, so the honest wins are k-independence and Theta(k) memory, not a large constant factor."}, {"id": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_next_greater_element", "label": "Next Greater Element", "file_type": "concept", "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "Mechanics", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_largest_rectangle_in_histogram", "label": "Largest Rectangle in a Histogram", "file_type": "concept", "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "The largest-rectangle pattern", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical Theta(n) application: a bar's rectangle extends to previous-smaller and next-smaller, both computed in one monotonic-stack pass; the pop is where the area is computed."}, {"id": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_store_indices_not_values", "label": "Store Indices, Not Values", "file_type": "rationale", "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "Pitfalls in Depth", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every maintenance rule is positional \u2014 window expiry, left boundary \u2014 and positions are only recoverable from indices. Also the only formulation that handles duplicate values correctly."}, {"id": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_deque_operation_ordering", "label": "Deque Operation Ordering (maintain back, evict front, read front)", "file_type": "rationale", "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "Pitfalls in Depth", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only one ordering of the three per-iteration operations is correct; reading the front before evicting reports a maximum outside the window, and the bug is rare in random data because it needs the max exactly at the expiring position. Keep the naive Theta(n*k) version as a permanent test oracle."}], "edges": [{"source": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_monotonic_stack", "target": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_next_greater_element", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "Mechanics", "weight": 1.0}, {"source": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_monotonic_stack", "target": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_largest_rectangle_in_histogram", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "The largest-rectangle pattern", "weight": 1.0}, {"source": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_monotonic_deque", "target": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_monotonic_stack", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "Mental Model", "weight": 1.0}, {"source": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_store_indices_not_values", "target": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_monotonic_deque", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "Pitfalls in Depth", "weight": 1.0}, {"source": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_deque_operation_ordering", "target": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_monotonic_deque", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "data-structures-and-algorithms/monotonic-stack-and-queue/learning.md", "source_location": "Pitfalls in Depth", "weight": 1.0}, {"source": "data_structures_and_algorithms_monotonic_stack_and_queue_learning_monotonic_deque", "target": "data_structures_and_algorithms_range_query_structures_learning_sparse_table", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "data-structure